# Names only — never commit values. Set these in the Vercel project (Settings → Environment Variables,
# Production + Preview). Read by api/state.js and api/media.js; the other functions need none. See MIGRATION.md.

# The public Vercel Blob store: the screen state (state/screen.json) and the uploaded images and MP3s
# (lobby-media/). Injected when the store is connected to the project. Required.
BLOB_READ_WRITE_TOKEN=

# Admin PIN used only while no PIN is stored in the state; the first authenticated write stores it.
LOBBY_ADMIN_PIN=

# ── Optional, legacy, read-only ──
# Only for the one-time seed: when Blob holds no state yet, the first read copies the newer of these
# into Blob and never reads them again. Leave unset when the old stores are unreachable.
# Redis key lobby_state:yesod9. Either pair works; UPSTASH_* wins.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Supabase table lobby_state, row yesod9.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Fallback only when the service key is absent.
SUPABASE_ANON_KEY=
