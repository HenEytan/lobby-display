# Names only — never commit values. Set these in the Vercel project (Settings → Environment Variables,
# Production + Preview). Read by api/state.js and api/media.js; the other functions need none. See MIGRATION.md.

# Screen state in Upstash Redis (key lobby_state:yesod9). Either pair works; UPSTASH_* wins.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Names Vercel's Upstash / KV integration injects:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Supabase table lobby_state, row yesod9 — copied into Redis once (first read, or scripts/seed-state.sh),
# never read again after that. Needed only until the seed has run.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Fallback only when the service key is absent; remove once SUPABASE_SERVICE_ROLE_KEY is set.
SUPABASE_ANON_KEY=

# Admin PIN used only while no PIN is stored in the state; the first authenticated write stores it.
LOBBY_ADMIN_PIN=

# Uploaded images and MP3s (api/media.js). Injected when a Vercel Blob store (public access) is
# connected to the project.
BLOB_READ_WRITE_TOKEN=
